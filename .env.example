VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_WHATSAPP_NUMBER=50500000000

# Solo Vercel/backend: permiten recalcular estimaciones diariamente sin encender una computadora.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CRON_SECRET=use-a-random-secret-of-at-least-16-characters

# Solo backend o Supabase Edge Functions. Nunca usar el prefijo VITE_ aquí.
AFTERSHIP_API_KEY=
SHIP24_API_KEY=
TRACK17_API_KEY=

# Correos automáticos al cliente cuando cambia el estado del pedido (api/notificar-estado).
# SMTP de Google Workspace: SMTP_USER es tu correo del dominio y SMTP_PASS una "Contraseña de aplicación".
NOTIFY_SECRET=use-a-random-secret-of-at-least-16-characters
SMTP_USER=info@tudominio.com
SMTP_PASS=your-google-app-password
SMTP_FROM=HAUSLINE <info@tudominio.com>
APP_URL=https://hausline-tracking.vercel.app
# Opcionales (por defecto usa Gmail/Workspace):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
