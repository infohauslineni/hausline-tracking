{
  "name": "HAUSLINE · WF2 Confirmar abono y crear pedido",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "hausline-aprobar-abono",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wf2-webhook",
      "name": "Webhook Aprobar abono",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "hausline-aprobar-abono"
    },
    {
      "parameters": {
        "jsCode": "const q = ($input.first().json.query) || {};\nif (!q.token || q.token !== $vars.ADMIN_APPROVAL_SECRET) {\n  return [{ json: { ok: false, error: 'token_invalido' } }];\n}\nif (!q.borrador) {\n  return [{ json: { ok: false, error: 'falta_borrador' } }];\n}\nreturn [{ json: { ok: true, borrador: q.borrador, metodo: q.metodo || null } }];"
      },
      "id": "wf2-valida",
      "name": "Validar token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [
            { "id": "c1", "leftValue": "={{$json.ok}}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ]
        },
        "options": {}
      },
      "id": "wf2-if",
      "name": "¿Token válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$vars.SUPABASE_URL}}/rest/v1/rpc/wa_confirmar_borrador",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$vars.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Authorization", "value": "=Bearer {{$vars.SUPABASE_SERVICE_ROLE_KEY}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"p_borrador_id\": \"{{$json.borrador}}\",\n  \"p_metodo_pago\": {{ $json.metodo ? JSON.stringify($json.metodo) : 'null' }}\n}",
        "options": {}
      },
      "id": "wf2-confirmar",
      "name": "RPC wa_confirmar_borrador",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 220]
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst base = ($vars.TRACKING_BASE_URL || '').replace(/\\/+$/, '');\nconst url = `${base}?codigo=${r.codigo}`;\nconst nombre = r.nombre ? `, ${r.nombre}` : '';\nconst mensaje = `✅ Hola${nombre}. Tu pedido HAUSLINE fue confirmado.\\nCódigo: ${r.codigo}\\nTotal: USD ${Number(r.total||0).toFixed(2)}  ·  Saldo pendiente: USD ${Number(r.saldo||0).toFixed(2)}\\nEl tiempo estimado de entrega es de 15 a 25 días hábiles.\\nPuedes consultar su progreso aquí: ${url}`;\nreturn [{ json: { ...r, tracking_url: url, mensaje } }];"
      },
      "id": "wf2-msg",
      "name": "Construir confirmación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{$vars.WHATSAPP_PHONE_NUMBER_ID}}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{$vars.WHATSAPP_TOKEN}}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{$json.wa_id}}\",\n  \"type\": \"text\",\n  \"text\": { \"body\": {{ JSON.stringify($json.mensaje) }} }\n}",
        "options": {}
      },
      "id": "wf2-notify",
      "name": "Avisar al cliente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 220],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=Pedido {{$('Construir confirmación').item.json.codigo}} confirmado y notificado al cliente. Ya puedes cerrar esta ventana.",
        "options": {}
      },
      "id": "wf2-ok",
      "name": "Respuesta admin OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1520, 220]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseCode": 401,
        "responseBody": "=No autorizado o borrador inválido ({{$json.error}}).",
        "options": {}
      },
      "id": "wf2-deny",
      "name": "Respuesta 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [860, 420]
    }
  ],
  "connections": {
    "Webhook Aprobar abono": { "main": [[{ "node": "Validar token", "type": "main", "index": 0 }]] },
    "Validar token": { "main": [[{ "node": "¿Token válido?", "type": "main", "index": 0 }]] },
    "¿Token válido?": {
      "main": [
        [{ "node": "RPC wa_confirmar_borrador", "type": "main", "index": 0 }],
        [{ "node": "Respuesta 401", "type": "main", "index": 0 }]
      ]
    },
    "RPC wa_confirmar_borrador": { "main": [[{ "node": "Construir confirmación", "type": "main", "index": 0 }]] },
    "Construir confirmación": { "main": [[{ "node": "Avisar al cliente", "type": "main", "index": 0 }]] },
    "Avisar al cliente": { "main": [[{ "node": "Respuesta admin OK", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}
