# =====================================================================
#  HAUSLINE · Vendedor virtual de WhatsApp (n8n)
#  Copia estos valores en las Variables de entorno de n8n
#  (Settings -> Variables, o env vars del contenedor si es self-host).
#  Los workflows los leen con $env.NOMBRE: NUNCA se escriben en los JSON.
# =====================================================================

# ---------- WhatsApp Cloud API (Meta) ----------
WHATSAPP_TOKEN=                      # Token permanente del System User (whatsapp_business_messaging)
WHATSAPP_PHONE_NUMBER_ID=            # Phone Number ID (WhatsApp > API Setup)
WHATSAPP_BUSINESS_ACCOUNT_ID=        # WABA ID
WHATSAPP_VERIFY_TOKEN=               # Cadena secreta que TÚ inventas; la repites en Meta y en el WF1
META_APP_SECRET=                     # App > Settings > Basic > App Secret (valida la firma X-Hub)
BUSINESS_PHONE_NUMBER=50578995116    # Tu número (para descartar mensajes propios). Solo dígitos.
ADMIN_WHATSAPP_NUMBER=505XXXXXXXX    # Número del admin que recibe avisos internos. Solo dígitos.

# ---------- Inteligencia artificial (Claude) ----------
AI_API_KEY=                          # Clave de Anthropic
AI_MODEL=claude-sonnet-5             # Modelo por defecto (rápido y capaz)
AI_API_URL=https://api.anthropic.com/v1/messages

# ---------- Hausline Tracking (Supabase) ----------
# n8n habla DIRECTO con Supabase usando la service_role (solo en el servidor).
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=           # service_role (NUNCA la anon; NUNCA con prefijo VITE_)

# ---------- Catálogo y enlaces ----------
CATALOG_URL=https://hauslineshopni.es
CATALOG_JSON_URL=https://hauslineshopni.es/catalogo-productos.json
TRACKING_BASE_URL=https://tu-app-tracking.vercel.app/rastreo   # Base pública de seguimiento

# ---------- n8n ----------
N8N_WEBHOOK_URL=https://tu-n8n.com   # Base pública de n8n (sin / al final). Se usa para armar el enlace de aprobación.

# ---------- Seguridad interna del bot ----------
ADMIN_APPROVAL_SECRET=               # Token para el enlace de aprobación de abonos (WF2). Aleatorio, >=24 chars.
